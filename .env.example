# ─── Réservation d'appels (Google Agenda) ────────────────────────────────────
# 1. Google Cloud Console → créer un projet → activer « Google Calendar API »
# 2. IAM → Comptes de service → créer un compte → onglet Clés → Ajouter une clé JSON
# 3. Google Agenda → Paramètres de l'agenda de réservation → « Partager avec des personnes » :
#    ajouter l'e-mail du compte de service avec « Apporter des modifications aux événements »
# 4. Renseigner les variables ci-dessous sur l'hébergement de l'API (ex. Vercel → Settings → Environment Variables)

NUXT_GOOGLE_SERVICE_ACCOUNT_EMAIL=reservation@mon-projet.iam.gserviceaccount.com
# Clé privée du JSON (champ private_key), sur une ligne avec les \n
NUXT_GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# ID de l'agenda (Paramètres de l'agenda → Intégrer l'agenda), ex. contact@kps-agency.com
NUXT_GOOGLE_CALENDAR_ID=contact@kps-agency.com

# Optionnel — Google Workspace uniquement : e-mail de l'utilisateur à « incarner » (délégation au niveau du domaine,
# scope https://www.googleapis.com/auth/calendar). Active l'invitation du client et le lien Google Meet automatique.
NUXT_GOOGLE_IMPERSONATE=

# Site statique (Hostinger) : URL où l'API tourne, ex. https://kps-agency.vercel.app (vide si même domaine)
NUXT_PUBLIC_BOOKING_API=
# Origines supplémentaires autorisées à appeler l'API (séparées par des virgules)
NUXT_BOOKING_ALLOWED_ORIGINS=

# Formulaire de contact (Formspree, Brevo…)
NUXT_PUBLIC_FORM_ENDPOINT=
