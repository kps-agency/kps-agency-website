# ─── Réservation d'appels ────────────────────────────────────────────────────
# Fournisseur d'agenda : ksuite (Infomaniak, par défaut) ou google
NUXT_CALENDAR_PROVIDER=ksuite

# ── kSuite (calendrier Infomaniak, protocole CalDAV) ──
# 1. Manager Infomaniak → Mon profil → Sécurité → Mots de passe d'application → en créer un (« Site KPS »)
# 2. Calendrier Infomaniak → paramètres de l'agenda des rendez-vous → Synchronisation / CalDAV → copier l'adresse de l'agenda
NUXT_CALDAV_URL=https://sync.infomaniak.com/calendars/IDENTIFIANT/ID-AGENDA/
NUXT_CALDAV_USERNAME=IDENTIFIANT_OU_EMAIL_INFOMANIAK
NUXT_CALDAV_PASSWORD=mot-de-passe-d-application
# Liens de visio kMeet générés pour les rendez-vous « Visio » (vider pour ne pas en générer)
NUXT_KMEET_BASE=https://kmeet.infomaniak.com/

# ── E-mails (boîte Hostinger, SMTP) : confirmations de rendez-vous et demandes de contact ──
NUXT_SMTP_HOST=smtp.hostinger.com
NUXT_SMTP_PORT=465
NUXT_SMTP_USER=contact@kps-agency.com
NUXT_SMTP_PASSWORD=mot-de-passe-de-l-adresse-ou-d-application
NUXT_MAIL_FROM="KPS Agency <contact@kps-agency.com>"
# Adresse qui reçoit les demandes de contact / devis
NUXT_CONTACT_NOTIFY_EMAIL=contact@kps-agency.com
# Adresse qui reçoit la notification de chaque nouveau rendez-vous
NUXT_BOOKING_NOTIFY_EMAIL=contact@kps-agency.com

# ── Google Agenda (si NUXT_CALENDAR_PROVIDER=google) ──
# Google Cloud → activer « Google Calendar API » → compte de service + clé JSON → partager l'agenda avec ce compte
NUXT_GOOGLE_SERVICE_ACCOUNT_EMAIL=
NUXT_GOOGLE_PRIVATE_KEY=
NUXT_GOOGLE_CALENDAR_ID=
NUXT_GOOGLE_IMPERSONATE=

# ── Hébergement de l'API ──
# Si les pages restent statiques et que l'API tourne ailleurs (ex. hébergement Node.js Infomaniak) : son URL publique
NUXT_PUBLIC_BOOKING_API=
# Origines supplémentaires autorisées à appeler l'API (séparées par des virgules)
NUXT_BOOKING_ALLOWED_ORIGINS=

# ─── Supabase (voir supabase/README.md) ─────────────────────────────────────
# Supabase → Project Settings → API. Mettre les vraies valeurs dans .env (jamais dans ce fichier, qui est publié sur GitHub)
SUPABASE_URL=
# Clé publishable (sb_publishable_…) : lue au build pour les articles publiés du blog
SUPABASE_PUBLISHABLE_KEY=
# Clé secrète (sb_secret_…) : serveur uniquement, enregistre les demandes de contact et d'appel
SUPABASE_SECRET_KEY=

# Formulaire de contact : vide = API interne /api/contact (Supabase + e-mail) ; sinon URL d'un service externe (Formspree, Brevo…)
NUXT_PUBLIC_FORM_ENDPOINT=

# ─── Cloudinary (images) ────────────────────────────────────────────────────
# Console Cloudinary → Settings → API Keys. Nom du cloud vide = fichiers locaux de public/images
CLOUDINARY_CLOUD_NAME=
# Clé et secret : uniquement pour l'envoi des images (node --env-file=.env scripts/cloudinary-upload.mjs)
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
